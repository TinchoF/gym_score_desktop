{
  "name": "gym-score-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GymScore — Modo Sede. Sirve un torneo GymScore sin internet desde una laptop.",
  "author": "GymScore",
  "main": "dist/main/index.js",
  "scripts": {
    "prepare-resources": "bash scripts/prepare-resources.sh",
    "build:ts": "tsc -p tsconfig.json",
    "start": "npm run build:ts && electron .",
    "dist": "npm run prepare-resources && npm run build:ts && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "mongodb-memory-server": "^10.1.2",
    "qrcode": "^1.5.4"
  }
}
